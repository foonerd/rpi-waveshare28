#!/bin/bash
#
# Configure the Waveshare 2.8 inch SPI panel.
#
# Usage:
#   waveshare28-config show
#   waveshare28-config set rotation=90 [speed=32000000]
#   waveshare28-config apply
#   waveshare28-config verify
#   waveshare28-config recover
#
# ## Where the truth lives
#
# /boot/waveshare28.conf is the durable copy. /boot survives both an OTA
# (which extracts a tar over it, overwriting only what the tar contains) and a
# factory reset (which reformats the data partition and leaves /boot alone).
# Everything else this tool writes is derived from it and is regenerated by
# `apply`.
#
# A factory reset destroys the root overlay, taking the binary, the unit and
# the module with it, so the installer has to be re-run. The durable file
# surviving means that re-run restores your settings rather than asking again.
#
# ## Why there is no boot splash on the panel
#
# One SPI chip select, two possible owners. Plymouth needs a framebuffer, so
# the fbtft driver; the renderer needs /dev/spidev0.0, which fbtft's overlay
# disables. The SPI core refuses a second device on a claimed chip select, so
# they cannot coexist.
#
# An overlay could be applied at runtime, which makes it removable, but
# plymouthd binds its framebuffer when it starts in the initramfs and does not
# adopt one that appears later. Measured: plymouth-start at 20:56:36, fb1 at
# 20:56:37, nothing drawn until quit at 20:57:13.
#
# So a splash on this panel needs the overlay applied from inside the
# initramfs, which is a change to volumio-os, not something an installer can
# do. Instead the renderer starts early and shows host addresses until the
# player answers, which is more use than a logo anyway.

set -euo pipefail

CONF="/boot/waveshare28.conf"
USERCONFIG="/boot/userconfig.txt"
TOML="/etc/waveshare28-panel.toml"
UNIT_DIR="/etc/systemd/system"
BIN_DIR="/usr/local/bin"
UNIT="waveshare28-panel.service"

# Defaults, used when the durable file is absent or partial.
rotation=0
speed=32000000

log()  { printf '[waveshare28] %s\n' "$*"; }
warn() { printf '[waveshare28] WARNING: %s\n' "$*" >&2; }
die()  { printf '[waveshare28] ERROR: %s\n' "$*" >&2; exit 1; }

require_root() {
    [[ $EUID -eq 0 ]] || die "run as root"
}

validate_rotation() {
    case "$1" in
        0|90|180|270) ;;
        *) die "rotation must be 0, 90, 180 or 270, got '$1'" ;;
    esac
}

load_conf() {
    [[ -f "$CONF" ]] || return 0

    local line key value
    while IFS= read -r line; do
        line="${line%%#*}"
        line="${line// /}"
        [[ -n "$line" ]] || continue
        key="${line%%=*}"
        value="${line#*=}"
        case "$key" in
            rotation) rotation="$value" ;;
            speed)    speed="$value" ;;
            splash)   warn "'splash' is obsolete and ignored; see the header of this script" ;;
            *)        warn "ignoring unknown key in ${CONF}: ${key}" ;;
        esac
    done < "$CONF"
}

save_conf() {
    cat > "$CONF" <<EOF
# Waveshare 2.8 inch SPI panel configuration.
#
# This is the durable copy. It lives on /boot because that partition survives
# both an OTA update and a factory reset, unlike the root filesystem. Every
# other file this configuration produces is derived from it; run
# 'waveshare28-config apply' to regenerate them.

# Panel rotation in degrees clockwise: 0, 90, 180 or 270.
rotation=${rotation}

# SPI clock in Hz.
speed=${speed}
EOF
    log "wrote ${CONF}"
}

# Add a line to userconfig.txt if absent, and refuse anything the firmware
# would silently truncate.
#
# Config lines past 100 characters lose their tail with no warning anywhere,
# which presents as a parameter that appears set and does nothing.
ensure_line() {
    local line="$1"
    [[ ${#line} -lt 100 ]] || die "config line is ${#line} chars, must be under 100"
    [[ -f "$USERCONFIG" ]] || die "${USERCONFIG} not found; is this a Volumio Pi image?"
    grep -qxF "$line" "$USERCONFIG" || {
        log "adding to userconfig.txt: ${line}"
        printf '%s\n' "$line" >> "$USERCONFIG"
    }
}

remove_lines() {
    local pattern="$1"
    grep -qE "$pattern" "$USERCONFIG" 2>/dev/null || return 0
    log "removing from userconfig.txt: ${pattern}"
    sed -i -E "/${pattern}/d" "$USERCONFIG"
}

write_toml() {
    cat > "$TOML" <<EOF
# Generated by waveshare28-config from ${CONF}. Edits here are overwritten.
rotation = ${rotation}
spi_speed_hz = ${speed}
EOF
    log "wrote ${TOML}"
}

# The unit is deliberately a leaf: nothing in the system depends on it, and it
# depends only on local-fs.target, which is guaranteed.
#
# Two earlier arrangements wedged the boot and are recorded in DEFECTS.md:
#
#   DefaultDependencies=no + Before=basic.target + RequiresMountsFor=/boot
#     is an ordering cycle, because the mount is itself ordered as part of
#     basic.target. systemd broke it by deleting the job.
#
#   After=local-fs.target with Wants= on a unit that is WantedBy=sysinit.target
#     wedged the boot entirely: ping answered, nothing else did.
#
# The pattern here is Volumio's own: allo_relay_attenuator uses
# After=local-fs.target and waits for readiness in its own loop, which is
# exactly what the renderer does.
write_unit() {
    cat > "${UNIT_DIR}/${UNIT}" <<EOF
[Unit]
Description=Waveshare 2.8 inch SPI panel renderer
Documentation=https://github.com/foonerd/rpi-waveshare28
# Not ordered after volumio.service. The renderer shows host addresses until
# the player answers, so waiting would leave the panel dark for the whole boot
# to no purpose.
After=local-fs.target
# Rate limiting lives in [Unit], not [Service]: it moved there in systemd 229
# and only the older StartLimitInterval was ever a [Service] key.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStart=${BIN_DIR}/waveshare28-panel
# Bounded failure: a hung start cannot hold the unit open indefinitely, and
# the burst limit above stops a crash loop rather than restarting forever.
TimeoutStartSec=30
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=waveshare28-panel
# Opens /dev/spidev0.0, /dev/i2c-1 and /dev/gpiochip0. Volumio already puts
# the volumio user in the spi, i2c and gpio groups.
User=volumio
Group=volumio
SupplementaryGroups=spi i2c gpio

[Install]
WantedBy=multi-user.target
EOF
    log "wrote ${UNIT_DIR}/${UNIT}"
}

# Never make a unit persistent until it has been observed to start.
#
# This is the measure that would have prevented a bricked device. Writing a
# unit and enabling it means the first evidence of a mistake arrives on the
# next boot, which is exactly when you may no longer have a shell. Verifying,
# starting, and confirming it is running first means a bad unit fails while
# you are still looking at it.
enable_safely() {
    systemctl daemon-reload

    log "checking unit syntax"
    if ! systemd-analyze verify "${UNIT_DIR}/${UNIT}" 2>&1 | tee /tmp/waveshare28-verify.log; then
        die "systemd-analyze verify failed; unit not enabled. See /tmp/waveshare28-verify.log"
    fi
    # verify exits 0 on warnings too, so treat any output as a refusal.
    if [[ -s /tmp/waveshare28-verify.log ]]; then
        cat /tmp/waveshare28-verify.log >&2
        die "systemd-analyze verify reported problems; unit not enabled"
    fi

    log "starting before enabling"
    systemctl restart "$UNIT" || die "unit failed to start; not enabled. journalctl -u ${UNIT}"

    # Give it a moment to fall over on its own if it is going to.
    sleep 3
    systemctl is-active --quiet "$UNIT" || {
        systemctl status "$UNIT" --no-pager || true
        die "unit did not stay running; not enabled"
    }

    log "unit is running, enabling for boot"
    systemctl enable "$UNIT" >/dev/null
}

cmd_apply() {
    require_root
    load_conf

    # Validate before writing anything, so a bad value cannot leave the system
    # half configured.
    validate_rotation "$rotation"
    if ! [[ "$speed" =~ ^[0-9]+$ ]] || [[ "$speed" -le 0 ]]; then
        die "speed must be a positive number, got '${speed}'"
    fi

    # A display overlay applied by the firmware is merged into the device tree
    # before the kernel starts and cannot be removed at runtime, so the
    # renderer could never open /dev/spidev0.0.
    remove_lines '^dtoverlay=(fbtft|mipi-dbi-spi)'
    remove_lines '^dtparam=(width|height|reset_pin|dc_pin|led_pin|rotate)='

    ensure_line "dtparam=spi=on"
    ensure_line "dtoverlay=cst328"

    write_toml
    write_unit
    enable_safely

    log "applied."
    log "SPI settings in userconfig.txt take effect on the next boot."
}

cmd_set() {
    require_root
    load_conf

    local arg key value
    for arg in "$@"; do
        key="${arg%%=*}"
        value="${arg#*=}"
        case "$key" in
            rotation) rotation="$value" ;;
            speed)    speed="$value" ;;
            *)        die "unknown setting: ${key}" ;;
        esac
    done

    validate_rotation "$rotation"
    save_conf
    cmd_apply
}

cmd_show() {
    load_conf
    printf 'rotation = %s degrees clockwise\n' "$rotation"
    printf 'speed    = %s Hz\n' "$speed"
    printf 'source   = %s\n' "$([[ -f $CONF ]] && echo "$CONF" || echo 'defaults')"
}

# Report drift without changing anything, exiting non-zero if anything
# differs, so it is usable from a health check.
cmd_verify() {
    load_conf
    local bad=0

    check() {
        if [[ -n "$2" ]]; then
            printf '  ok    %s\n' "$1"
        else
            printf '  DRIFT %s\n' "$1"
            bad=1
        fi
    }

    log "verifying against ${CONF}"

    check "userconfig.txt has dtparam=spi=on" \
        "$(grep -qxF 'dtparam=spi=on' "$USERCONFIG" 2>/dev/null && echo y)"
    check "userconfig.txt has dtoverlay=cst328" \
        "$(grep -qxF 'dtoverlay=cst328' "$USERCONFIG" 2>/dev/null && echo y)"
    check "userconfig.txt has no firmware-applied display overlay" \
        "$(grep -qE '^dtoverlay=(fbtft|mipi-dbi-spi)' "$USERCONFIG" 2>/dev/null || echo y)"
    check "${TOML} exists" "$([[ -f $TOML ]] && echo y)"
    check "${TOML} matches rotation" \
        "$(grep -qxF "rotation = ${rotation}" "$TOML" 2>/dev/null && echo y)"
    check "unit installed" "$([[ -f ${UNIT_DIR}/${UNIT} ]] && echo y)"
    check "unit enabled" "$(systemctl is-enabled --quiet "$UNIT" 2>/dev/null && echo y)"
    check "binary installed" "$([[ -x ${BIN_DIR}/waveshare28-panel ]] && echo y)"

    # The touch module is built against one exact kernel and will not load on
    # another. An OTA that changes the kernel silently breaks touch with
    # nothing obviously wrong, so it is worth naming.
    local kver
    kver="$(uname -r)"
    if [[ -d "/lib/modules/${kver}" ]]; then
        check "touch module present for ${kver}" \
            "$(find "/lib/modules/${kver}" -name 'hynitron_cstxxx.ko*' -print -quit 2>/dev/null)"
    fi

    [[ $bad -eq 0 ]] || {
        warn "configuration has drifted; run 'waveshare28-config apply'"
        exit 1
    }
    log "no drift"
}

# Undo everything that could keep the device from booting cleanly, for the
# case where it still boots but the panel service is misbehaving.
#
# Deliberately does not touch /boot/waveshare28.conf: the settings should
# survive so a later 'apply' restores them.
cmd_recover() {
    require_root

    log "disabling and removing the unit"
    systemctl disable --now "$UNIT" >/dev/null 2>&1 || true
    rm -f "${UNIT_DIR}/${UNIT}"
    # Left over from an earlier design that applied an overlay at boot.
    systemctl disable --now waveshare28-splash.service >/dev/null 2>&1 || true
    rm -f "${UNIT_DIR}/waveshare28-splash.service"
    systemctl daemon-reload

    log "recovered. ${CONF} kept; run 'waveshare28-config apply' to reinstate."
    log "If the device would not boot, the units live on the data partition"
    log "under /dyn/etc/systemd/ and can be removed with the card in a reader."
}

main() {
    local cmd="${1:-show}"
    shift || true

    case "$cmd" in
        show)    cmd_show ;;
        set)     [[ $# -gt 0 ]] || die "set needs at least one key=value"; cmd_set "$@" ;;
        apply)   cmd_apply ;;
        verify)  cmd_verify ;;
        recover) cmd_recover ;;
        *)       die "usage: $0 [show|set key=value...|apply|verify|recover]" ;;
    esac
}

main "$@"
